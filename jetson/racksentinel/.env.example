# Public-safe example only. Never commit live addresses, credentials, or tokens.
AARI_SITE_ID=local-lab
AARI_NODE_ROLE=jetson-edge
AARI_BIND_HOST=127.0.0.1
AARI_BIND_PORT=9105
AARI_SAMPLE_INTERVAL_SECONDS=10
AARI_WARNING_TEMP_C=80
AARI_CRITICAL_TEMP_C=90
AARI_DATA_PATH=/var/lib/aari-racksentinel/telemetry.jsonl

# Set these only on the device when Splunk HEC is ready.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

